# 复制为 .env 后按实际环境修改（docker compose 会自动读取同名文件）

# 必填：Postgres 连接串
SYNC_DATABASE_URL=postgres://chatsync:chatsync@localhost:5432/chatsync?sslmode=disable

# 监听地址
SYNC_ADDR=:8080

# 允许的前端来源，逗号分隔；留空表示禁止跨域。
# 前端与同步服务不同源时（例如静态页在 GitHub Pages、服务自部署）必须配置，
# 否则浏览器预检会被拦。不要用 *（带凭证请求不允许通配）。
# WebSocket /api/watch 的握手也按这份白名单校验 Origin；反代需放行 Upgrade。
SYNC_ALLOWED_ORIGINS=http://localhost:8090,https://your-frontend.example.com

# 托管在 HTTPS 后面时设为 true，会附加 HSTS 头
SYNC_REQUIRE_HTTPS=false

# 登录 token 有效期
SYNC_TOKEN_TTL=720h

# 单个会话 JSON 大小上限（字节）
SYNC_MAX_SESSION_BYTES=8388608

# 单个附件大小上限（字节）
SYNC_MAX_FILE_BYTES=33554432

# 登录限流：每个 IP 在窗口内的最大尝试次数
SYNC_LOGIN_LIMIT=10
SYNC_LOGIN_WINDOW=15m
